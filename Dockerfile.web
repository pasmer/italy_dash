FROM python:3.11-slim

WORKDIR /app

# Copy requirements and install
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application files and template directory
COPY app.py .
COPY dashboard.html .
COPY Template/ ./Template/
COPY www/ ./www/
COPY style.css .

EXPOSE 8100

CMD ["python", "app.py"]
